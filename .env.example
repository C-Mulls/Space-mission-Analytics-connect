# Copy to .env (local) or set in Vercel Project Settings (production).
# No quotes around values; no spaces around =.

# NextAuth (required for Google login)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth — Web application client from Google Cloud Console → Credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google (local) or https://<your-domain>/api/auth/callback/google (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database — required for NextAuth sessions and app data (Vercel Postgres, Neon, or any Postgres)
DATABASE_URL=
